# ==================== Envs ====================
{{- range .env }}
{{- $vars := .vars }}

# --- {{ .category }} ---
{{- range sortAlpha (keys $vars) }}
export {{ printf . }}="{{ index $vars . }}"
{{- end -}}
{{- end }}


# ==================== Paths ====================

# --- all paths ---
export PATH="{{ .paths | join ":" }}{{ if eq .chezmoi.os "darwin" }}:{{ .paths_darwin | join ":" }}{{ end }}:$PATH"


# ==================== Aliases ====================
{{- range .aliases }}
{{- $cmds := .cmds }}

# --- {{ .category }} ---
{{- range sortAlpha (keys $cmds) }}
alias {{ . }}='{{ index $cmds . }}'
{{- end }}
{{- end }}


{{- if eq .chezmoi.os "darwin" }}
{{- range .aliases_darwin }}
{{- $cmds := .cmds }}

# --- {{ .category }}(macOS) ---
{{- range sortAlpha (keys $cmds) }}
alias {{ . }}='{{ index $cmds . }}'
{{- end }}
{{- end }}
{{- end }}

{{- if lookPath "nvidia-smi" }}

# --- nvidia-smi ---
alias ns='nvidia-smi'
{{- end }}

# ==================== Initializations ====================

# 最初のプロンプトに必要な処理だけを同期読み込みする。
export SHELDON_CONFIG_DIR="$HOME/.config/sheldon"
typeset -r ZSH_DEFER_PLUGIN="${XDG_DATA_HOME:-$HOME/.local/share}/sheldon/repos/github.com/romkatv/zsh-defer/zsh-defer.plugin.zsh"

if [[ -r "$ZSH_DEFER_PLUGIN" ]]; then
    source "$ZSH_DEFER_PLUGIN"
    source "$SHELDON_CONFIG_DIR/plugins/local/sync/ssh-terminal.plugin.zsh"

    setopt prompt_subst
    PROMPT='%F{cyan}%1~%f %F{green}❯%f '

    if command -v starship &>/dev/null; then
        zsh-defer -c 'eval "$(starship init zsh)"'
    fi

    if command -v sheldon &>/dev/null; then
        zsh-defer -m -p -r -c 'eval "$(sheldon source)"'
    fi
elif command -v sheldon &>/dev/null; then
    eval "$(sheldon source)"
fi
